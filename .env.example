# ReconAI — Environment Configuration
# Phase 1 Foundation Required Variables

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reconai?schema=public"

# Redis Connection (BullMQ Queue Processing)
REDIS_URL="redis://localhost:6379"

# API & Web App Ports
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# ML Service URL
ML_SERVICE_URL="http://localhost:8000"

# Phase 2+ Variables (Required in subsequent phases)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Phase 6+ LLM Integration
OPENAI_API_KEY=""

# Security Key
JWT_SECRET=""
